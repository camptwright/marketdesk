# Copy to /opt/apps/marketdesk/.env on reekserver-1. Never commit the real file.
POSTGRES_PASSWORD=
API_BEARER_TOKEN=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
QUOTE_CACHE_SECONDS=600
MARKET_TIMEZONE=America/Chicago
# Routed through reekserver-1's shared Cloudflare Tunnel (id
# af0c35fc-ec30-407e-8f9c-56c76e4e8e22, also serving OpenWebUI) — no
# per-app tunnel or token needed. Connect the `cloudflared` container to
# this project's compose network, then add a Public Hostname route in the
# Zero Trust dashboard pointing at http://marketdesk-app-1:8000.
